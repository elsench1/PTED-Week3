difftime_secs <- function(x, y){
as.numeric(difftime(x, y, units = "secs"))
}
distance_by_element <- function(later, now){
as.numeric(
st_distance(later, now, by_element = TRUE)
)
}
st_layers(FILE)
GPS_Track <- st_read(FILE, layer = "track_points")
GPS_Track <- GPS_Track |>
st_transform(crs = 2056)
head(GPS_Track)
View(difftime_secs)
difftime_secs <- function(x, y){
as.numeric(difftime(x, y, units = "secs"))
}
